{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "outDir": "./lib",
    "rootDir": "./src", 
    "strict": true,
    "removeComments": true,
    "declaration": true
  },
  "include": ["src/**/*"]
}
